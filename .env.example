# VayuPulse AI Environment Configuration

# Primary AI Provider ('openai' | 'gemini')
AI_PRIMARY_PROVIDER=openai

# OpenAI Models
OPENAI_API_KEY=
OPENAI_MODEL_PLANNER=gpt-6.1-sol
OPENAI_MODEL_FAST=gpt-6-luna

# Google Gemini Models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Gateway Security & Ports
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173

# Telemetry Source ('simulated' | 'openmeteo' | 'openaq')
TELEMETRY_SOURCE=simulated
